rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@abu-jubair-298f0.firebaseapp.com';
    }
    match /project-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
