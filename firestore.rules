rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@abu-jubair-298f0.firebaseapp.com';
    }
    match /admins/{email} { allow read: if request.auth != null && request.auth.token.email == email; allow write: if false; }
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
